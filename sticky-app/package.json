{
  "name": "sticky-app",
  "version": "0.1.0",
  "description": "Sticky – Handy-Zwilling für den reTerminal Sticky (BLE-Durchstich)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test tests/",
    "wasm": "node -e \"const fs=require('fs');fs.mkdirSync('public/pdfjs-wasm',{recursive:true});for(const f of fs.readdirSync('node_modules/pdfjs-dist/wasm'))fs.copyFileSync('node_modules/pdfjs-dist/wasm/'+f,'public/pdfjs-wasm/'+f)\"",
    "predev": "npm run wasm --silent",
    "prebuild": "npm run wasm --silent"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/share": "^8.0.3",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^8.3.5"
  }
}
